var slateUserActionPrefixes = [
    "org.freedesktop.NetworkManager.",
    "org.freedesktop.login1.power-off",
    "org.freedesktop.login1.reboot",
    "org.freedesktop.timedate1.set-timezone"
];

var slateUpdateUnits = {
    "slate-update-check.service": ["start"],
    "slate-update-install.service": ["start", "stop"]
};

polkit.addRule(function (action, subject) {
    if (subject.user !== "slate") {
        return polkit.Result.NOT_HANDLED;
    }
    for (var i = 0; i < slateUserActionPrefixes.length; i++) {
        if (action.id.indexOf(slateUserActionPrefixes[i]) === 0) {
            return polkit.Result.YES;
        }
    }
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        var verbs = slateUpdateUnits[unit];
        if (verbs && verbs.indexOf(verb) >= 0) {
            return polkit.Result.YES;
        }
        if (/^slate-update-install-app@[a-z0-9][a-z0-9-]*\.service$/.test(unit) && (verb === "start" || verb === "stop")) {
            return polkit.Result.YES;
        }
        if (/^slate-app@[a-z0-9][a-z0-9-]*\.service$/.test(unit) && (verb === "start" || verb === "restart")) {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NOT_HANDLED;
});
