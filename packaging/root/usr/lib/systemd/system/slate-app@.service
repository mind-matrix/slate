[Unit]
Description=Slate app %i
After=slate-apps-sync.service network.target
ConditionPathExists=/usr/lib/slate-apps/%i/run

[Service]
Type=exec
NotifyAccess=none
User=app-%i
Group=app-%i
ExecStart=/usr/lib/slate-apps/%i/run
StateDirectory=slate-apps/%i
StateDirectoryMode=0700
WorkingDirectory=/var/lib/slate-apps/%i
Environment=HOME=/var/lib/slate-apps/%i
Restart=on-failure
RestartSec=5
TimeoutStopSec=60s
KillMode=mixed
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
